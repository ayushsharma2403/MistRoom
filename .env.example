# ── MistRoom Backend ──────────────────────────────────

# Application
APP_NAME=MistRoom Relay API
APP_VERSION=0.1.0
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET_KEY=CHANGE_ME_generate_a_64_char_random_hex_string

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── MySQL ─────────────────────────────────────────────
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=mistroom
MYSQL_USER=mistroom
MYSQL_PASSWORD=CHANGE_ME_use_strong_password
MYSQL_ROOT_PASSWORD=CHANGE_ME_use_strong_root_password

# SQLAlchemy async URL (constructed from above in config.py)
# DATABASE_URL=mysql+aiomysql://mistroom:password@mysql:3306/mistroom

# ── Redis (optional) ─────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ── Rate Limiting ────────────────────────────────────
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_REGISTRATION_PER_HOUR=5

# ── Envelope / Attachment Limits ─────────────────────
MAX_ENVELOPE_SIZE_BYTES=65536
MAX_ATTACHMENT_SIZE_BYTES=524288000
MAX_CHUNK_SIZE_BYTES=262144
ENVELOPE_RETENTION_HOURS=168
ATTACHMENT_RETENTION_HOURS=720

# ── Logging ──────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json

# ── Admin ────────────────────────────────────────────
ADMIN_API_KEY=CHANGE_ME_generate_admin_api_key
